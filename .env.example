# Server
PORT=3000
NODE_ENV=production
SESSION_SECRET=a_very_secret_key_change_me

# Login (Passwort des Admin-Kontos beim ersten Start)
ADMIN_PASSWORD=dein_passwort_hier

# Paperless, SMTP, Nuki, Telegram, WhatsApp, iCal und Preise werden in der App
# unter „Einstellungen“ gespeichert, nicht in dieser Datei.

# Cloudflare Tunnel (cloudflared auf demselben Rechner -> http://localhost:3000) braucht hier nichts.
# Nur noch über Tunnel/Proxy erreichbar (Port 3000 von außen zu): LISTEN_HOST=127.0.0.1
# LISTEN_HOST=
# Hinter Reverse-Proxy/Tunnel: welchen Proxys vertraut wird (Standard: lokal + Heimnetz)
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Server-Wächter (watchdog.js, eigener PM2-Prozess "beckhome-watchdog", startet mit ./update.sh)
# Meldet per Telegram (Token/IDs aus den Einstellungen), wenn App, Domain über den Tunnel oder Speicher Probleme machen.
# Optional: externer Heartbeat, damit auch ein Totalausfall des Servers gemeldet wird, z. B. kostenlos bei
# https://healthchecks.io (Check mit Periode 5 min, Grace 10 min, Integration „Telegram“) und die Ping-URL hier eintragen:
# WATCHDOG_HEARTBEAT_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Nur falls die Domain anders geprüft werden soll als die „Öffentliche Adresse“ der Webseite:
# WATCHDOG_PUBLIC_URL=https://beckhome.cloud/api/health
